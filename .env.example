MODERATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
STANDARD_DAILY_LIMIT=50
HIGHER_COST_DAILY_LIMIT=15
# 0 means unlimited; individual user overrides take priority.
