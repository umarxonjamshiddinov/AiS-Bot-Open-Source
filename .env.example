AIS_API_BASE_URL=
TAVILY_API_KEY=
SUPPORT_CONTACT=
AI_MAX_CONCURRENT_REQUESTS=4
AI_DEFAULT_MAX_OUTPUT_TOKENS=4096
AI_RETRY_COUNT=0
AI_REQUEST_TIMEOUT_SECONDS=120
SAFETY_SHADOW_ENABLED=true
SAFETY_SHADOW_QUEUE_SIZE=32
